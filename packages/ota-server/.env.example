# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
OTA_SECRET=change-me-in-production
# Public URL of the deployed server (used to build download links for local storage)
BASE_URL=https://your-app.onrender.com

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Storage backend ───────────────────────────────────────────────────────────
# "supabase" for production, "local" for dev (files saved to ./uploads/)
STORAGE_BACKEND=supabase

# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key — keep secret, never expose to clients

# Name of the Supabase Storage bucket (create it manually in the dashboard)
OTA_BUCKET_NAME=ota-bundles
